{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "description": "Đảo Đèn Lồng — game 3D (Day 12 AI SDLC lab)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && node scripts/launch.cjs",
    "bench": "node scripts/launch.cjs --bench --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc headless/soak.js --seed 7 --nights 10 --out soak.json",
    "export-leaderboard": "node scripts/launch.cjs --export-leaderboard leaderboard-export.json",
    "headless": "node headless/run.js",
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "electron@33.3.1": true,
    "esbuild@0.24.2": true
  }
}
